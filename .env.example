# AlphaBrief local environment template.
#
# Do not commit real API keys, broker keys, or secrets.
#
# Routed paper brokers (Round 0065): FX/metals/indices -> OANDA practice,
# US equities + crypto -> Alpaca paper. A venue without credentials
# degrades to the built-in simulated paper broker. Alpaca paper is free
# at https://app.alpaca.markets (paper trading enabled by default).
# Default paper broker: OANDA v20 practice (paper). Set both
# ALPHABRIEF_OANDA_TOKEN and ALPHABRIEF_OANDA_ACCOUNT_ID to enable external
# practice observation. With both set, the scheduler's broker factory prefers
# OANDA over Alpaca. The approved OANDA-only cutover is M01 in
# ALPHABRIEF_PRODUCT_BLUEPRINT.md; current migration status is in
# docs/progress.yaml.

ALPHABRIEF_ENV=local
ALPHABRIEF_LOG_LEVEL=INFO
ALPHABRIEF_LIVE_TRADING_ENABLED=false
ALPHABRIEF_DATA_DIR=data/local
ALPHABRIEF_REPORTS_DIR=reports/generated
ALPHABRIEF_AUDIT_LOG_DIR=reports/audit
ALPHABRIEF_EXECUTION_POLICY_FILE=config/paper_execution_policy.yaml

# Optional: AI daily trading cycle.
# ALPHABRIEF_AI_TRADING_ENABLED=true lets the scheduler run ai_daily_cycle.
# Keep external paper disabled until broker credentials, local data ingestion,
# risk policy, and process supervision have been verified.
ALPHABRIEF_AI_TRADING_ENABLED=false
ALPHABRIEF_AI_EXTERNAL_PAPER_ENABLED=false
# 11-symbol default AI universe spanning the routed venues: FX (OANDA),
# crypto and US equities (Alpaca paper, or the built-in simulator when no
# Alpaca credentials are set). Override with any comma-separated list of
# policy symbols.
ALPHABRIEF_AI_SCHEDULER_UNIVERSE=EUR_USD,GBP_USD,USD_JPY,BTC-USD,ETH-USD,SOL-USD,AAPL,NVDA,TSLA,SPY,QQQ
ALPHABRIEF_AI_MODEL_PROVIDER=auto
# ALPHABRIEF_AI_MODEL_NAME=gpt-4o-mini
# ALPHABRIEF_AI_MODEL_BASE_URL=http://localhost:11434
ALPHABRIEF_AI_MODEL_TIMEOUT_SECONDS=30
ALPHABRIEF_AI_PRE_CYCLE_INGEST_ENABLED=true
ALPHABRIEF_AI_MARKET_DATA_SOURCE=yahoo
ALPHABRIEF_AI_MARKET_DATA_INTERVAL=1d
ALPHABRIEF_AI_MARKET_DATA_LOOKBACK_DAYS=10
ALPHABRIEF_AI_NEWS_SOURCE=rss
ALPHABRIEF_AI_NEWS_FEEDS=marketwatch-rss,reuters-rss,bloomberg-atom
ALPHABRIEF_AI_NEWS_LOOKBACK_HOURS=24
ALPHABRIEF_AI_NEWS_LIMIT=30

# Optional: free macro data source (FRED). Register at
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional: free market data (Alpha Vantage). Register at
# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# In auto mode, AlphaBrief uses OpenAI when this key is present; otherwise
# it falls back to the conservative fake provider.
# OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Routed paper brokers (Round 0065): FX/metals/indices -> OANDA practice;
# US equities + crypto -> Alpaca paper. A venue without credentials degrades
# to the built-in simulated paper broker, so the system works out of the box.
# OANDA: sign up at https://www.oanda.com/ and create a demo account, then
# generate a personal access token and copy the demo account ID.
# ─────────────────────────────────────────────────────────────────────────
# ALPHABRIEF_OANDA_TOKEN=
# ALPHABRIEF_OANDA_ACCOUNT_ID=

# Optional: external paper broker for US equities + crypto (Alpaca Paper).
# Sign up at https://app.alpaca.markets/signup (select "Paper" mode) and
# generate a paper API key under "View" -> "API Keys" in the dashboard.
# Without these, equities/crypto trade on the built-in simulator.
# The historical Alpaca path remains only until M01 deletes it. Do not start
# formal observation with this path. See docs/oanda_30_day_runbook.md.
# ALPHABRIEF_ALPACA_KEY=
# ALPHABRIEF_ALPACA_SECRET=
