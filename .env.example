# AlphaBrief local environment template.
#
# Do not commit real API keys, broker keys, or secrets.

ALPHABRIEF_ENV=local
ALPHABRIEF_LOG_LEVEL=INFO
ALPHABRIEF_LIVE_TRADING_ENABLED=false
ALPHABRIEF_DATA_DIR=data/local
ALPHABRIEF_REPORTS_DIR=reports/generated
ALPHABRIEF_AUDIT_LOG_DIR=reports/audit
ALPHABRIEF_EXECUTION_POLICY_FILE=config/paper_execution_policy.yaml

# Optional: free macro data source (FRED). Register at
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional: free market data source (Alpha Vantage). Register at
# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
