# AlphaBrief environment template.
#
# Copy to .env for local development. Never commit real credentials.
#
# Execution is OANDA v20 practice only. Missing credentials fail closed:
# nothing is ever filled locally, and there is no live-trading mode.
# In the packaged app the OANDA credentials are written by the onboarding
# page into <data_dir>/secrets/ instead of living here.

# Data directory (absolute path required). Default:
# ~/Library/Application Support/AlphaBrief
# ALPHABRIEF_HOME=/Users/you/Library/Application Support/AlphaBrief

# OANDA v20 practice credentials. Create a demo account at
# https://www.oanda.com/ and generate a personal access token.
ALPHABRIEF_OANDA_TOKEN=
ALPHABRIEF_OANDA_ACCOUNT_ID=

# Trading switch: off (default) runs the whole cycle but stops before
# submitting; on submits to the OANDA practice account.
ALPHABRIEF_TRADING_MODE=off

# Backend port for the local API and dashboard.
ALPHABRIEF_PORT=8765

# Optional fallback model channel (OpenAI-compatible, pay per call).
# Only used when model.fallback_enabled is set in the configuration.
# Hosts containing opencode.ai are rejected.
# ALPHABRIEF_LLM_BASE_URL=
# ALPHABRIEF_LLM_API_KEY=
# ALPHABRIEF_LLM_MODEL=

# Optional FRED macro calendar. Without a key the event window check
# falls back to news shock filtering.
FRED_API_KEY=

# Logging: DEBUG, INFO, WARNING or ERROR (default INFO).
ALPHABRIEF_LOG_LEVEL=INFO
