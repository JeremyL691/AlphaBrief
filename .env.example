# AlphaBrief local environment template.
#
# Do not commit real API keys, broker keys, or secrets.

ALPHABRIEF_ENV=local
ALPHABRIEF_LOG_LEVEL=INFO
ALPHABRIEF_LIVE_TRADING_ENABLED=false
ALPHABRIEF_DATA_DIR=data/local
ALPHABRIEF_REPORTS_DIR=reports/generated
ALPHABRIEF_AUDIT_LOG_DIR=reports/audit
ALPHABRIEF_EXECUTION_POLICY_FILE=config/paper_execution_policy.yaml

# Optional: free macro data source (FRED). Register at
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional: free market data source (Alpha Vantage). Register at
# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Optional: external paper broker (OANDA v20 demo/practice).
# Sign up at https://www.oanda.com/ and create a demo account, then generate
# a personal access token and copy the demo account ID from the dashboard.
# When both OANDA and Alpaca credentials are set, OANDA is preferred.
# ALPHABRIEF_OANDA_TOKEN=
# ALPHABRIEF_OANDA_ACCOUNT_ID=

# Optional: external paper broker (Alpaca Paper Trading).
# Sign up at https://app.alpaca.markets/signup (select "Paper" mode) and
# generate a paper API key under "View" -> "API Keys" in the dashboard.
# Leaving all broker credentials blank keeps AlphaBrief in NullBrokerAdapter
# (dev/CI) mode; both Alpaca vars must be set to switch to AlpacaPaperAdapter.
# See docs/paper_broker_setup.md for the 30-day observation runbook.
# ALPHABRIEF_ALPACA_KEY=
# ALPHABRIEF_ALPACA_SECRET=
